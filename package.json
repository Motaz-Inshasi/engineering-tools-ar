{
  "name": "engineering-tools-ar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "generate": "node scripts/generate.mjs",
    "test": "npm run test:unit && npm run test:site && npm run test:browser",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:site": "node --test \"tests/site/**/*.test.js\"",
    "test:browser": "playwright test",
    "i18n": "node scripts/i18n.mjs extract && node scripts/i18n.mjs build && node scripts/generate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "acorn": "8.19.0",
    "jsqr": "1.4.0",
    "katex": "0.19.1",
    "qrcode-generator": "2.0.4"
  }
}
