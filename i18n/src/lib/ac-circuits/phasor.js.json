[
 {
  "k": "095c6857db5a",
  "text": "حاسبة الطور (Phasor): اجمع أو اطرح أو اضرب أو اقسم إشارتين جيبيتين بالصيغة القطبية أو الديكارتية، وحوّل الناتج إلى الصيغة الزمنية v(t)، مع مخطط الطور ورسم الموجات."
 },
 {
  "k": "6739f75b511a",
  "text": "طور",
  "ctx": "keywords: [\"طور\", \"فيزور\", \"phasor\", \"جمع الإشارات الجيبية\", \"صيغة قطبية\", \"مخطط الطور\", \"v(t)\"],"
 },
 {
  "k": "9017e6272100",
  "text": "فيزور",
  "ctx": "keywords: [\"طور\", \"فيزور\", \"phasor\", \"جمع الإشارات الجيبية\", \"صيغة قطبية\", \"مخطط الطور\", \"v(t)\"],"
 },
 {
  "k": "904e396bf60f",
  "text": "جمع الإشارات الجيبية",
  "ctx": "keywords: [\"طور\", \"فيزور\", \"phasor\", \"جمع الإشارات الجيبية\", \"صيغة قطبية\", \"مخطط الطور\", \"v(t)\"],"
 },
 {
  "k": "df30876dea10",
  "text": "صيغة قطبية",
  "ctx": "keywords: [\"طور\", \"فيزور\", \"phasor\", \"جمع الإشارات الجيبية\", \"صيغة قطبية\", \"مخطط الطور\", \"v(t)\"],"
 },
 {
  "k": "b01c1ed59b92",
  "text": "مخطط الطور",
  "ctx": "keywords: [\"طور\", \"فيزور\", \"phasor\", \"جمع الإشارات الجيبية\", \"صيغة قطبية\", \"مخطط الطور\", \"v(t)\"],"
 },
 {
  "k": "83cc30a7aa11",
  "text": "التحويل بين الزمن والطور",
  "ctx": "{ label: \"التحويل بين الزمن والطور\", tex: \"v(t) = V_m\\\\cos(\\\\omega t + \\\\phi) \\\\;\\\\leftrightarrow\\\\; \\\\mathbf{V} = V_m\\\\angle\\\\phi\" },"
 },
 {
  "k": "25c1120b62c3",
  "text": "الجمع ديكارتياً والضرب قطبياً",
  "ctx": "{ label: \"الجمع ديكارتياً والضرب قطبياً\", tex: \"\\\\mathbf{V}_1 + \\\\mathbf{V}_2 = (a_1+a_2) + j(b_1+b_2),\\\\qquad \\\\mathbf{V}_1\\\\mathbf{V}_2 = V_1V_2\\\\angle(\\\\phi_"
 },
 {
  "k": "f4e3614181c1",
  "text": "الطور الأول",
  "ctx": "{ id: \"p1\", label: \"الطور الأول\", type: \"text\", default: \"10∠30\", help: \"قطبي مثل 10∠30 (بالدرجات) أو ديكارتي مثل 8.66+5j.\" },"
 },
 {
  "k": "360cfa0771b8",
  "text": "قطبي مثل 10∠30 (بالدرجات) أو ديكارتي مثل 8.66+5j."
 },
 {
  "k": "2b1a169ff812",
  "text": "الطور الثاني",
  "ctx": "{ id: \"p2\", label: \"الطور الثاني\", type: \"text\", default: \"5∠-45\" },"
 },
 {
  "k": "f8046d0fb62a",
  "text": "العملية",
  "ctx": "{ id: \"op\", label: \"العملية\", type: \"select\", default: \"add\", options: [[\"add\", \"جمع\"], [\"sub\", \"طرح\"], [\"mul\", \"ضرب\"], [\"div\", \"قسمة\"]] },"
 },
 {
  "k": "b1f76dbb6759",
  "text": "جمع",
  "ctx": "{ id: \"op\", label: \"العملية\", type: \"select\", default: \"add\", options: [[\"add\", \"جمع\"], [\"sub\", \"طرح\"], [\"mul\", \"ضرب\"], [\"div\", \"قسمة\"]] },"
 },
 {
  "k": "589622282ec3",
  "text": "طرح",
  "ctx": "{ id: \"op\", label: \"العملية\", type: \"select\", default: \"add\", options: [[\"add\", \"جمع\"], [\"sub\", \"طرح\"], [\"mul\", \"ضرب\"], [\"div\", \"قسمة\"]] },"
 },
 {
  "k": "c3af406c4a7a",
  "text": "ضرب",
  "ctx": "{ id: \"op\", label: \"العملية\", type: \"select\", default: \"add\", options: [[\"add\", \"جمع\"], [\"sub\", \"طرح\"], [\"mul\", \"ضرب\"], [\"div\", \"قسمة\"]] },"
 },
 {
  "k": "570e7293a3a3",
  "text": "قسمة",
  "ctx": "{ id: \"op\", label: \"العملية\", type: \"select\", default: \"add\", options: [[\"add\", \"جمع\"], [\"sub\", \"طرح\"], [\"mul\", \"ضرب\"], [\"div\", \"قسمة\"]] },"
 },
 {
  "k": "de9ab3e7bc36",
  "text": "التردد (لكتابة v(t))",
  "ctx": "{ id: \"f\", label: \"التردد (لكتابة v(t))\", unit: \"Hz\", type: \"number\", default: \"50\" }"
 },
 {
  "k": "496724858469",
  "text": "مثال: جمع $10\\angle 30^\\circ$ و $5\\angle -45^\\circ$."
 },
 {
  "k": "53b581b1699f",
  "text": "التردد",
  "ctx": "const f = num(input, \"f\", \"التردد\", { positive: true });"
 },
 {
  "k": "53d94970253c",
  "text": "نكتب الطورين بالصيغتين:",
  "ctx": "{ text: \"نكتب الطورين بالصيغتين:\", tex: `\\\\mathbf{A} = ${cpolarTex(a, 6)} = ${ctex(a, 6)},\\\\quad \\\\mathbf{B} = ${cpolarTex(b, 6)} = ${ctex(b, 6)}` }"
 },
 {
  "k": "8592f9ab71da",
  "text": "الجمع والطرح أسهل بالصيغة الديكارتية:",
  "ctx": "steps.push({ text: \"الجمع والطرح أسهل بالصيغة الديكارتية:\", tex: `${ctex(a, 6)} ${op === \"add\" ? \"+\" : \"-\"} (${ctex(b, 6)}) = ${ctex(z, 6)}` });"
 },
 {
  "k": "2ad49cae715e",
  "text": "ثم نعود للقطبية:",
  "ctx": "steps.push({ text: \"ثم نعود للقطبية:\", tex: `|\\\\mathbf{R}| = ${ntex(cabs(z), 6)},\\\\quad \\\\angle\\\\mathbf{R} = ${ntex(D(z), 5)}^\\\\circ` });"
 },
 {
  "k": "b8af1ac3dbf2",
  "text": "لا يمكن القسمة على طور مقداره صفر.",
  "ctx": "if (op === \"div\" && cabs(b) === 0) fail(\"لا يمكن القسمة على طور مقداره صفر.\", \"p2\");"
 },
 {
  "k": "1660777623a7",
  "text": "الضرب أسهل قطبياً: نضرب المقادير ونجمع الزوايا:"
 },
 {
  "k": "2925ee2e0913",
  "text": "القسمة قطبياً: نقسم المقادير ونطرح الزوايا:"
 },
 {
  "k": "650261d2dd40",
  "text": "بالصيغة الزمنية (الإشارتان بالتردد نفسه):"
 },
 {
  "k": "5d8dae3e616d",
  "text": "الناتج",
  "ctx": "if (op === \"add\" || op === \"sub\") series.push({ name: \"الناتج\", points: sampleFunction(sig(z), 0, 2 * T, 400), width: 3 });"
 },
 {
  "k": "aefd41f88619",
  "text": "الناتج قطبياً",
  "ctx": "{ label: \"الناتج قطبياً\", tex: cpolarTex(z, 6), text: cpolarText(z, 4) },"
 },
 {
  "k": "a34cf5cd58b2",
  "text": "الناتج ديكارتياً",
  "ctx": "{ label: \"الناتج ديكارتياً\", tex: ctex(z, 6), text: cfmt(z, 6) },"
 },
 {
  "k": "7eb5ed1ed7d9",
  "text": "الصيغة الزمنية",
  "ctx": "...(op === \"add\" || op === \"sub\" ? [{ label: \"الصيغة الزمنية\", tex: `r(t) = ${timeTex(z)}`, text: timeText(z) }] : [])"
 },
 {
  "k": "5e7e54a7d4f6",
  "text": "الموجات خلال دورين ({%0})",
  "ctx": "blocks: [phasorBlock([[\"A\", a], [\"B\", b], [\"الناتج\", z]]), { type: \"plot\", title: `الموجات خلال دورين (${eng(f, \"Hz\")})`, xLabel: \"t (s)\", yLabel: \"v\", series }"
 }
]
