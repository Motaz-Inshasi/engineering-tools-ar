  "text": "زمن النقل:",
  "ctx": "{ text: \"زمن النقل:\", tex: `t = \\\\frac{N}{S_{\\\\text{eff}}} = \\\\frac{${ntex(bits)}}{${ntex(effective)}} = ${ntex(T, 6)}\\\\ \\\\text{s}` }"
 },
 {
